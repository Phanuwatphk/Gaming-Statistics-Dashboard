# Create a .env file locally (or export this variable in your shell) before
# fetching live game data from RAWG.
RAWG_API_KEY=key

# The shared Steam Top 50 snapshot is refreshed for a new visitor only when it
# is older than this many minutes. Use 0 to force every visit.
PLAYER_REFRESH_MINUTES=15

# Optional: override the default SQLite file location.
# GAMING_DASHBOARD_DB=data/gaming_statistics.db
